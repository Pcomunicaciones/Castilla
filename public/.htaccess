# Configuración para Next.js Static Export con trailingSlash: true
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Si se solicita un archivo .html directamente, redirigir a la versión limpia (opcional pero recomendado)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.html [NC]
  RewriteRule ^ %1/ [R=301,L]

  # 2. Manejo de errores 404
  # Si el archivo o carpeta no existe, mostrar el 404.html de Next.js
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /404.html [L]

  # 3. Asegurar que las carpetas siempre tengan el slash final para que Apache encuentre el index.html
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.+[^/])$ /$1/ [R=301,L]
</IfModule>

# Impedir listado de directorios (evita el 403 si falta el index.html)
Options -Indexes

# Asegurar permisos correctos (opcional, algunos servidores lo ignoran)
<Files ".htaccess">
  Order allow,deny
  Deny from all
</Files>
